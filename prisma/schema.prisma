// [adv-back.md] / prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 1. ATUALIZAMOS O "ROLE" PARA INCLUIR VISITANTE
enum Role {
  COLABORADOR
  GESTOR
  ASSESSOR_DIRETOR
  DESENVOLVEDOR
  VISITANTE
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  fullName String
  password String
  role     Role   @default(COLABORADOR)

  // Relações
  profile          Profile? // Perfil do Colaborador
  viagens          Viagem[] // Viagens criadas por este colaborador
  convite          ConviteVisitante? // O convite que este visitante usou
  profileVisitante ProfileVisitante? // O perfil deste visitante
}

model Profile {
  id                Int     @id @default(autoincrement())
  cargo             String?
  departamento      String?
  centroCustoPadrao String?
  matricula         String?
  telefone          String?
  user              User    @relation(fields: [userId], references: [id])
  userId            Int     @unique
}

// 2. ADICIONAMOS A RELAÇÃO DE "CONVITES"
model Viagem {
  id                  Int      @id @default(autoincrement())
  destino             String
  origem              String
  dataIda             DateTime //@db.DateTime(0)
  dataVolta           DateTime //@db.DateTime(0)
  motivo              String
  status              String
  valorEstimado       Float? //@db.Double
  tipoTransporte      String?
  necessitaHospedagem Boolean  @default(false)

  colaboradorId Int
  colaborador   User @relation(fields: [colaboradorId], references: [id])

  despesas Despesa[]
  convites ConviteVisitante[]
  eventos  EventoTimeline[]
  comunicados Comunicado[]
  hotelInfo   HotelInfo?
}

model Despesa {
  id                   Int      @id @default(autoincrement())
  tipo                 String
  valor                Float //@db.Double
  data                 DateTime //@db.DateTime(0)
  descricao            String?
  notaFiscalUrl        String?
  comprovanteImagemUrl String? // <-- Verifique se você adicionou isso no passo anterior
  status               String   @default("pendente")

  viagemId Int
  viagem   Viagem @relation(fields: [viagemId], references: [id])

  eventoTimelineId Int?
  eventoTimeline   EventoTimeline? @relation("EventoDespesas", fields: [eventoTimelineId], references: [id])

  justificativaReprovacao String?

  @@index([viagemId])
  @@index([eventoTimelineId])
}

// 3. ADICIONAMOS A NOVA TABELA DE CONVITES
model ConviteVisitante {
  id       Int     @id @default(autoincrement())
  token    String  @unique
  email    String // <-- @unique REMOVIDO
  cpf      String // <-- @unique REMOVIDO
  foiUsado Boolean @default(false)

  viagem   Viagem @relation(fields: [viagemId], references: [id])
  viagemId Int

  visitanteUser   User? @relation(fields: [visitanteUserId], references: [id])
  visitanteUserId Int?  @unique
  expiresAt       DateTime
}

// 4. ADICIONAMOS A NOVA TABELA DE PERFIL DE VISITANTE
model ProfileVisitante {
  id                Int       @id @default(autoincrement())
  documento         String? // CPF, RG ou Passaporte
  dataNascimento    DateTime? @db.Date
  telefone          String?
  alergias          String?   @db.Text
  condicoesMedicas  String?   @db.Text
  contatoEmergencia String? // Ex: "Maria (mãe) - (11) 99999-9999"

  // Relação 1-para-1 com o User
  user   User @relation(fields: [userId], references: [id])
  userId Int  @unique
}

model EventoTimeline {
  id             Int       @id @default(autoincrement())
  titulo         String
  descricao      String?
  dataHoraInicio DateTime
  dataHoraFim    DateTime?
  local          String?
  tipo           String // Ex: 'voo', 'hotel', 'reuniao', 'transfer'

  viagem   Viagem @relation(fields: [viagemId], references: [id])
  viagemId Int

  despesas Despesa[] @relation("EventoDespesas")

  @@index([viagemId])
}

model Comunicado {
  id        Int      @id @default(autoincrement())
  titulo    String
  conteudo  String
  createdAt DateTime @default(now())

  viagem    Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId  Int

  @@index([viagemId])
}

model HotelInfo {
  id             Int     @id @default(autoincrement())
  nomeHotel      String
  endereco       String
  checkIn        DateTime
  checkOut       DateTime
  horarioCafe    String? // Ex: "06:00 - 10:00"
  servicosInclusos String? // Ex: "Wi-Fi, Academia"
  eventosMissao  String? // Ex: "Jantar de networking dia 12"

  viagem    Viagem  @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  viagemId  Int     @unique // Cada viagem só tem um hotel info
}